          "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"clienteToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
