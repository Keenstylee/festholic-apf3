      "value": "http://localhost:8080"
    },
    {
      "key": "clienteEmail",
      "value": "cliente_apf3@example.com"
    },
    {
      "key": "clientePassword",
      "value": "CambiarClave_2026"
    },
    {
      "key": "adminEmail",
      "value": "tu_correo@ejemplo.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
