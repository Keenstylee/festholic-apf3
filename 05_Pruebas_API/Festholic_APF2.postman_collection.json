{
  "info": {
    "name": "Festholic APF2 - MySQL y JWT",
    "description": "Ejecutar por grupos. Tras registrar admin, cambiar su rol a ADMIN en Workbench y volver a iniciar sesión. Ver README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "eventoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Usuarios y login",
      "item": [
        {
          "name": "Registrar CLIENTE",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Cliente\",\n  \"email\": \"ana@festholic.pe\",\n  \"password\": \"clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"clienteId\", body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@festholic.pe\",\n  \"password\": \"clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"clienteToken\", body.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar futuro ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin Demo\",\n  \"email\": \"admin@festholic.pe\",\n  \"password\": \"clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN (después de actualizar el rol en MySQL)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@festholic.pe\",\n  \"password\": \"clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"adminToken\", body.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - JWT y permisos",
      "item": [
        {
          "name": "Listar eventos sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear evento sin token: 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/eventos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Festival de prueba\",\n  \"lugar\": \"Lima\",\n  \"fecha\": \"2027-06-20\",\n  \"capacidad\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear evento como CLIENTE: 403",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/eventos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Festival de prueba\",\n  \"lugar\": \"Lima\",\n  \"fecha\": \"2027-06-20\",\n  \"capacidad\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear evento como ADMIN: 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/eventos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Festival de prueba\",\n  \"lugar\": \"Lima\",\n  \"fecha\": \"2027-06-20\",\n  \"capacidad\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"eventoId\", body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar entradas como CLIENTE: 403",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/entradas",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar entradas como ADMIN: 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/entradas",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - JPQL, transacción y persistencia",
      "item": [
        {
          "name": "Buscar eventos activos por fecha",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos/buscar?fecha=2027-06-20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Compra sin token: 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/entradas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{clienteId}},\n  \"eventoId\": {{eventoId}},\n  \"cantidad\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Compra para otro usuario: 403",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/entradas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": 999999,\n  \"eventoId\": {{eventoId}},\n  \"cantidad\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Compra que agota el evento",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/entradas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{clienteId}},\n  \"eventoId\": {{eventoId}},\n  \"cantidad\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar de nuevo (evento agotado fuera del resultado)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos/buscar?fecha=2027-06-20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar evento desactivado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos/{{eventoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
